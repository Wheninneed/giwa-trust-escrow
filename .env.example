# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해서 실제 값을 채우세요.
#   packages/contracts/.env   ← 배포용 (DEPLOYER_PRIVATE_KEY 등)
#   apps/web/.env.local       ← 프론트엔드용 (NEXT_PUBLIC_* )
#
# .env* 는 .gitignore 되어 있습니다. 절대 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# ── 네트워크 ────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=91342
NEXT_PUBLIC_GIWA_RPC_URL=https://sepolia-rpc.giwa.io
NEXT_PUBLIC_GIWA_EXPLORER_URL=https://sepolia-explorer.giwa.io

# ── 배포된 컨트랙트 주소 ────────────────────────────────────
# pnpm deploy:giwa 실행 후 출력되는 값을 넣으세요.
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=
NEXT_PUBLIC_MOCK_KRW_ADDRESS=

# ── 컨트랙트 배포 (packages/contracts/.env) ─────────────────
# 테스트넷 전용 지갑의 개인키를 쓰세요. 실제 자산이 있는 지갑은 절대 쓰지 마세요.
# 이 값은 contracts 패키지에서만 읽히며 클라이언트 번들에 포함되지 않습니다.
DEPLOYER_PRIVATE_KEY=
GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io

# ── 데모 계약 시딩 (선택) ───────────────────────────────────
# scripts/seed-demo.ts 가 쓰는 값. 고객(배포자)과 서로 다른 주소여야 합니다.
DEMO_PROVIDER_ADDRESS=
DEMO_ARBITER_ADDRESS=

# ── 증빙 파일 저장소 (apps/web/.env.local) ──────────────────
# 설정하지 않으면 업로드 기능만 꺼지고 나머지는 그대로 동작합니다.
# 설정 방법은 supabase/README.md 참고.
#
# service_role 키는 서버 라우트에서만 읽습니다.
# NEXT_PUBLIC_ 을 붙이면 브라우저에 노출되어 누구나 DB 를 조작할 수 있습니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
